{
  "name": "@selcom-developers/selcom",
  "version": "0.1.4",
  "description": "Community TypeScript/Node client for the Selcom API gateway: signing, checkout, payouts and webhooks. Not affiliated with Selcom Paytech Ltd.",
  "keywords": [
    "selcom",
    "payments",
    "mobile-money",
    "tanzania",
    "checkout",
    "payouts",
    "webhooks",
    "hmac"
  ],
  "homepage": "https://github.com/selcom-developers/selcom-node#readme",
  "bugs": {
    "url": "https://github.com/selcom-developers/selcom-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selcom-developers/selcom-node.git"
  },
  "license": "Apache-2.0",
  "author": "The Selcom Developers community contributors",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SPEC_VERSION"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile node16",
    "sync-vectors": "node scripts/sync-vectors.mjs",
    "check-vectors": "node scripts/check-vectors.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^20.19.43",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}

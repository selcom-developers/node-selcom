{
  "operation": "checkout.stored-cards",
  "method": "GET",
  "path": "/v1/checkout/stored-cards",
  "kind": "other",
  "notes": "card_type 001 is Visa and 002 is Mastercard. Card tokens are sensitive: never log them in full.",
  "scenarios": [
    {
      "name": "success",
      "description": "Result code 000.",
      "http_status": 200,
      "body": {
        "reference": "REF0000000001",
        "resultcode": "000",
        "result": "SUCCESS",
        "message": "Card fetch successful",
        "data": [
          {
            "id": 23,
            "masked_card": "4111-11XX-XXXX-1111",
            "creation_date": "2026-11-01 09:00:00",
            "card_token": "CARDTOKEN-TEST-0001",
            "name": "TEST BUYER",
            "card_type": "001"
          },
          {
            "id": 24,
            "masked_card": "5555-55XX-XXXX-4444",
            "creation_date": "2026-11-02 09:00:00",
            "card_token": "CARDTOKEN-TEST-0002",
            "name": "TEST BUYER",
            "card_type": "002"
          }
        ]
      },
      "expected_status": "SUCCESS"
    },
    {
      "name": "in-progress-111",
      "description": "Result code 111: still processing. Query again after 3 minutes or more.",
      "http_status": 200,
      "body": {
        "reference": "REF0000000001",
        "resultcode": "111",
        "result": "INPROGRESS",
        "message": "Request in progress. You will receive a callback shortly.",
        "data": []
      },
      "expected_status": "PENDING"
    },
    {
      "name": "ambiguous-999",
      "description": "Result code 999: outcome unknown, wait for reconciliation. Never resubmit.",
      "http_status": 200,
      "body": {
        "reference": "REF0000000001",
        "resultcode": "999",
        "result": "AMBIGUOUS",
        "message": "Transaction status unknown (sample)",
        "data": []
      },
      "expected_status": "AMBIGUOUS"
    },
    {
      "name": "failure",
      "description": "Result code 400: any code outside 000, 111, 927, 999 (and 404 on a query) is a failure.",
      "http_status": 200,
      "body": {
        "reference": "REF0000000001",
        "resultcode": "400",
        "result": "FAIL",
        "message": "Unknown buyer (sample)",
        "data": []
      },
      "expected_status": "FAILED"
    },
    {
      "name": "not-found-404",
      "description": "Result code 404 on an operation that is not a status query is an ordinary failure, not NOT_FOUND.",
      "http_status": 200,
      "body": {
        "reference": "REF0000000001",
        "resultcode": "404",
        "result": "FAIL",
        "message": "Record not found (sample)",
        "data": []
      },
      "expected_status": "FAILED"
    },
    {
      "name": "gateway-error-no-json",
      "description": "No JSON body and no result code on an operation that moves no money: raise an invalid-response error.",
      "http_status": 502,
      "raw_body": "<html><body><h1>502 Bad Gateway</h1></body></html>",
      "expected_error": "INVALID_RESPONSE"
    }
  ]
}
